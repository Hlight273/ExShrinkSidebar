<UserControl x:Class="ExShrinkSidebar.UI.Views.EditConfigView.SubConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 输入与选择控件共用黑灰底色，蓝色只表达交互状态。 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#191D24"/>
            <Setter Property="Foreground" Value="#E7ECF4"/>
            <Setter Property="CaretBrush" Value="#E7ECF4"/>
            <Setter Property="SelectionBrush" Value="#416DA8"/>
            <Setter Property="BorderBrush" Value="#343D4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#53657D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#6A9EE8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E7ECF4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="OptionBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="#2C405D"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="OptionBorder" Property="Background" Value="#354E70"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="#C9D9EF"/>
            <Setter Property="Background" Value="#252F3E"/>
            <Setter Property="BorderBrush" Value="#3A4A61"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SelectorBorder" Background="#252F3E" BorderBrush="#3A4A61" BorderThickness="1" CornerRadius="5">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="#A8BBD6" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#6A9EE8"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="SelectorBorder" Property="BorderBrush" Value="#6A9EE8"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False" Margin="10,0,28,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                <Border Background="#202630" BorderBrush="#465A76" BorderThickness="1" CornerRadius="6"
                                        Padding="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="280" CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#252C37"/>
            <Setter Property="BorderBrush" Value="#343E4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#6A9EE8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#314865"/>
                    <Setter Property="BorderBrush" Value="#6A9EE8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3C5270"/>
                    <Setter Property="BorderBrush" Value="#92B8EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#252C37"/>
            <Setter Property="BorderBrush" Value="#343E4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#314865"/>
                    <Setter Property="BorderBrush" Value="#6A9EE8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="NodeBorder"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Padding="0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="124"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="34"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IndentPad" Grid.Column="0"/>

                <Control x:Name="ChildDragHandle" Grid.Column="1"
                         Width="28" Height="32" Margin="0,0,4,0" VerticalAlignment="Top"
                         Cursor="SizeAll" Focusable="False"
                         PreviewMouseLeftButtonDown="DragHandle_MouseDown"
                         PreviewMouseMove="DragHandle_MouseMove"
                         PreviewMouseLeftButtonUp="DragHandle_EndCapture"
                         LostMouseCapture="DragHandle_EndCapture">
                    <Control.Template>
                        <ControlTemplate TargetType="Control">
                            <Border x:Name="GripBackground" Background="Transparent" CornerRadius="4">
                                <Path x:Name="GripDots" Fill="#AAB8CA" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.Data>
                                        <GeometryGroup>
                                            <EllipseGeometry Center="2,2" RadiusX="1.2" RadiusY="1.2"/>
                                            <EllipseGeometry Center="8,2" RadiusX="1.2" RadiusY="1.2"/>
                                            <EllipseGeometry Center="2,8" RadiusX="1.2" RadiusY="1.2"/>
                                            <EllipseGeometry Center="8,8" RadiusX="1.2" RadiusY="1.2"/>
                                            <EllipseGeometry Center="2,14" RadiusX="1.2" RadiusY="1.2"/>
                                            <EllipseGeometry Center="8,14" RadiusX="1.2" RadiusY="1.2"/>
                                        </GeometryGroup>
                                    </Path.Data>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripBackground" Property="Background" Value="#FF465B78"/>
                                    <Setter TargetName="GripDots" Property="Fill" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Control.Template>
                </Control>

                <ToggleButton x:Name="ExpandBtn"
                              Grid.Column="2"
                              Width="28"
                              Height="32"
                              VerticalAlignment="Top"
                              Visibility="Collapsed"
                              Style="{StaticResource IconToggleStyle}"
                              Click="ExpandBtn_Click">
                    <Rectangle x:Name="ExpandIconMask" Width="14" Height="14" Fill="#AAB8CA">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Asset/Resource/Icons/pandown.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </ToggleButton>

                <ComboBox x:Name="TypeComboBox"
                          Grid.Column="3"
                          Margin="4,0"
                          VerticalAlignment="Top"
                          FontSize="12"
                          SelectionChanged="TypeComboBox_SelectionChanged"/>

                <StackPanel Grid.Column="4" Margin="4,0,8,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="ConfigNameLabelText" Visibility="Collapsed"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="#8291A6"
                                   FontSize="11"/>
                        <Border DockPanel.Dock="Right" Background="#293649" CornerRadius="4"
                                Margin="8,0,0,0" Padding="7,4" MinWidth="56" VerticalAlignment="Center">
                            <TextBlock x:Name="OrdinalText" Foreground="#A8C2E6" FontSize="11"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <TextBox x:Name="NameTextBox" AutomationProperties.LabeledBy="{Binding ElementName=ConfigNameLabelText}"
                                 MinWidth="150"
                                 VerticalAlignment="Center"
                                 TextChanged="NameTextBox_TextChanged"/>
                    </DockPanel>

                    <DockPanel LastChildFill="True" Margin="0,8,0,0">
                        <TextBlock x:Name="FunctionLabelText"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="#8291A6"
                                   FontSize="11"/>
                        <TextBlock x:Name="SummaryText"
                                   VerticalAlignment="Center"
                                   Foreground="#A6B1C2"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>

                <Button x:Name="MoreParamsBtn"
                        Grid.Column="5"
                        Width="28"
                        Height="32"
                        VerticalAlignment="Top"
                        Style="{StaticResource IconButtonStyle}"
                        Click="MoreParamsBtn_Click">
                    <Rectangle Width="14" Height="14" Fill="#AAB8CA">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Asset/Resource/Icons/more.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>

                <Button x:Name="AddChildBtn"
                        Grid.Column="6"
                        Width="28"
                        Height="32"
                        VerticalAlignment="Top"
                        Style="{StaticResource IconButtonStyle}"
                        Click="AddChildBtn_Click">
                    <Rectangle Width="14" Height="14" Fill="#AAB8CA">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Asset/Resource/Icons/add.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>

                <Button Grid.Column="7"
                        Width="28"
                        Height="32"
                        VerticalAlignment="Top"
                        Style="{StaticResource DeleteButtonStyle}"
                        Click="DeleteBtn_Click">
                    <Rectangle Width="14" Height="14" Fill="#AAB8CA">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Asset/Resource/Icons/delete.png" Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#344154" BorderThickness="1,0,0,0" Margin="12,2,0,0"
                Visibility="{Binding Visibility, ElementName=ChildrenContainer}">
            <StackPanel x:Name="ChildrenContainer" Visibility="Collapsed"/>
        </Border>
    </Grid>
</UserControl>
